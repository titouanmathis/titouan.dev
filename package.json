{
  "name": "titouan-dev",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "emdash": {
    "seed": "seed/seed.json"
  },
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "bootstrap": "emdash init && emdash seed",
    "seed": "emdash seed",
    "typecheck": "astro check",
    "token:create": "node ./scripts/create-admin-token.mjs",
    "import:legacy": "node ./scripts/import-legacy-content.mjs",
    "import:legacy:extras": "node ./scripts/import-legacy-experiments-links.mjs",
    "backfill:published-at": "node ./scripts/backfill-published-at.mjs",
    "fix:imported-mdx": "node ./scripts/fix-imported-mdx-content.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^10.0.0",
    "@astrojs/react": "^5.0.0",
    "@emdash-cms/auth-atproto": "^0.2.8",
    "@studiometa/playground-preview": "0.3.8",
    "@tailwindcss/vite": "^4.1.14",
    "astro": "^6.1.2",
    "better-sqlite3": "^12.8.0",
    "emdash": "^0.15.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "@studiometa/prettier-config": "^4.4.0",
    "@studiometa/stylelint-config": "^4.1.1"
  },
  "stylelint": {
    "extends": "@studiometa/stylelint-config",
    "rules": {
      "scss/at-rule-no-unknown": [
        true,
        {
          "ignoreAtRules": [
            "tailwind",
            "apply",
            "variants",
            "responsive",
            "screen",
            "config",
            "custom-variant",
            "theme"
          ]
        }
      ]
    }
  },
  "prettier": "@studiometa/prettier-config",
  "overrides": {
    "vite": "^7",
    "@cloudflare/kumo": "2.3.0"
  }
}
