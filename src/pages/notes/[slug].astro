---
import { getEmDashEntry, getEntryTerms } from 'emdash';
import { PortableText } from 'emdash/ui';
import Base from '../../layouts/Base.astro';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

const { entry: note, cacheHint } = await getEmDashEntry('notes', slug);

if (!note) {
  return Astro.redirect('/404');
}

Astro.cache.set(cacheHint);

function formatDate(date: Date | null): string {
  if (!date) return '';
  const d = String(date.getDate()).padStart(2, '0');
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const y = date.getFullYear();
  return `${d}/${m}/${y}`;
}

// Get tags from the tags text field
const tagList = note.data.tags ? note.data.tags.split(',').map((t: string) => t.trim()).filter(Boolean) : [];
---

<Base title={note.data.title} description={note.data.description} isMarkdown>
  <h1 class="text-3xl font-bold">{note.data.title}</h1>

  <small class="block tracking-wide uppercase opacity-70">
    {note.data.publishedAt && formatDate(note.data.publishedAt)}
    {tagList.length > 0 && (
      <> in {tagList.map((tag: string) => `#${tag}`).join(' ')}</>
    )}
  </small>

  <PortableText value={note.data.content} />
</Base>
