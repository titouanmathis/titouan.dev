<div class="flex flex-wrap gap-8">
  {# Two profile forms, each in its own DataScope with the same "person" group.
     Editing one never touches the other, and each scope has its own $data. #}
  <div data-component="DataScope" data-option-group="person" class="space-y-2">
    <div class="flex gap-2">
      <input
        name="first"
        value="Donald"
        data-component="DataModel"
        data-option-immediate
        class="w-28 border rounded px-2 py-1 bg-transparent" />
      <input
        name="last"
        value="Duck"
        data-component="DataModel"
        data-option-immediate
        class="w-28 border rounded px-2 py-1 bg-transparent" />
    </div>
    <p>
      Hello,
      <span
        data-component="DataComputed"
        data-option-compute="`${$data.first} ${$data.last}`.trim()"
        class="font-bold">
        Donald Duck
      </span>.
    </p>
  </div>

  <div data-component="DataScope" data-option-group="person" class="space-y-2">
    <div class="flex gap-2">
      <input
        name="first"
        value="Daisy"
        data-component="DataModel"
        data-option-immediate
        class="w-28 border rounded px-2 py-1 bg-transparent" />
      <input
        name="last"
        value="Duck"
        data-component="DataModel"
        data-option-immediate
        class="w-28 border rounded px-2 py-1 bg-transparent" />
    </div>
    <p>
      Hello,
      <span
        data-component="DataComputed"
        data-option-compute="`${$data.first} ${$data.last}`.trim()"
        class="font-bold">
        Daisy Duck
      </span>.
    </p>
  </div>
</div>
