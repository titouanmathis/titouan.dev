<div class="flex flex-wrap gap-10">
  {# No DataScope: both tab sets use the global "tabs" group, so switching a tab
     in one set switches the same tab in the other. #}
  <div class="min-w-[16rem]">
    <div role="tablist" class="flex gap-1 border-b border-current/20">
      <button
        type="button"
        role="tab"
        data-component="Action DataBind"
        data-option-group="tabs"
        data-on:click="DataModel(#utabs-a) -> target.set('overview')"
        data-bind:class.font-bold="value === 'overview'"
        class="px-3 py-2">
        Overview
      </button>
      <button
        type="button"
        role="tab"
        data-component="Action DataBind"
        data-option-group="tabs"
        data-on:click="DataModel(#utabs-a) -> target.set('specs')"
        data-bind:class.font-bold="value === 'specs'"
        class="px-3 py-2">
        Specs
      </button>
      <button
        type="button"
        role="tab"
        data-component="Action DataBind"
        data-option-group="tabs"
        data-on:click="DataModel(#utabs-a) -> target.set('reviews')"
        data-bind:class.font-bold="value === 'reviews'"
        class="px-3 py-2">
        Reviews
      </button>
    </div>
    <input
      id="utabs-a"
      type="hidden"
      value="overview"
      data-component="DataModel"
      data-option-group="tabs"
      data-option-immediate />
    <div
      data-component="DataBind"
      data-option-group="tabs"
      data-bind:attr.hidden="value !== 'overview'"
      class="py-3">
      A quick overview of the product.
    </div>
    <div
      data-component="DataBind"
      data-option-group="tabs"
      data-bind:attr.hidden="value !== 'specs'"
      class="py-3"
      hidden>
      The technical specifications.
    </div>
    <div
      data-component="DataBind"
      data-option-group="tabs"
      data-bind:attr.hidden="value !== 'reviews'"
      class="py-3"
      hidden>
      What customers are saying.
    </div>
  </div>

  <div class="min-w-[16rem]">
    <div role="tablist" class="flex gap-1 border-b border-current/20">
      <button
        type="button"
        role="tab"
        data-component="Action DataBind"
        data-option-group="tabs"
        data-on:click="DataModel(#utabs-b) -> target.set('overview')"
        data-bind:class.font-bold="value === 'overview'"
        class="px-3 py-2">
        Overview
      </button>
      <button
        type="button"
        role="tab"
        data-component="Action DataBind"
        data-option-group="tabs"
        data-on:click="DataModel(#utabs-b) -> target.set('specs')"
        data-bind:class.font-bold="value === 'specs'"
        class="px-3 py-2">
        Specs
      </button>
      <button
        type="button"
        role="tab"
        data-component="Action DataBind"
        data-option-group="tabs"
        data-on:click="DataModel(#utabs-b) -> target.set('reviews')"
        data-bind:class.font-bold="value === 'reviews'"
        class="px-3 py-2">
        Reviews
      </button>
    </div>
    <input
      id="utabs-b"
      type="hidden"
      value="overview"
      data-component="DataModel"
      data-option-group="tabs"
      data-option-immediate />
    <div
      data-component="DataBind"
      data-option-group="tabs"
      data-bind:attr.hidden="value !== 'overview'"
      class="py-3">
      A quick overview of the product.
    </div>
    <div
      data-component="DataBind"
      data-option-group="tabs"
      data-bind:attr.hidden="value !== 'specs'"
      class="py-3"
      hidden>
      The technical specifications.
    </div>
    <div
      data-component="DataBind"
      data-option-group="tabs"
      data-bind:attr.hidden="value !== 'reviews'"
      class="py-3"
      hidden>
      What customers are saying.
    </div>
  </div>
</div>
