      tabindex="0"
      data-component="DataBind"
      data-option-key="active"
      data-bind:attr.hidden="value !== 'specs'"
      class="py-3"
      hidden>
      The technical specifications.
    </div>
    <div
      role="tabpanel"
      id="panel-b-reviews"
      aria-labelledby="tab-b-reviews"
      tabindex="0"
      data-component="DataBind"
      data-option-key="active"
      data-bind:attr.hidden="value !== 'reviews'"
      class="py-3"
      hidden>
      What customers are saying.
    </div>
  </div>
</div>
