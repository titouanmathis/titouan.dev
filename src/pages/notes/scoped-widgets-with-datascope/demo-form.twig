<div data-component="DataScope" data-option-group="person" class="max-w-md space-y-3">
  <div class="flex gap-3">
    <label class="flex-1">
      <span class="block text-sm text-current/60">First name</span>
      <input
        name="first"
        value="Ada"
        data-component="DataModel"
        data-option-immediate
        class="w-full border rounded px-2 py-1 bg-transparent" />
    </label>
    <label class="flex-1">
      <span class="block text-sm text-current/60">Last name</span>
      <input
        name="last"
        value="Lovelace"
        data-component="DataModel"
        data-option-immediate
        class="w-full border rounded px-2 py-1 bg-transparent" />
    </label>
  </div>

  {# $data is a frozen snapshot of every keyed value in this scope's group. #}
  <p>
    Hello,
    <span
      data-component="DataComputed"
      data-option-compute="`${$data.first} ${$data.last}`.trim()"
      class="font-bold">
      Ada Lovelace
    </span>.
  </p>
</div>
